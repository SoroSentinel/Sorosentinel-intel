{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:sorosentinel:schema:v1:ScanReport",
  "title": "ScanReport",
  "description": "Scan CLI output. Indicators, never verdicts. Deterministic for the same WASM bytes and ruleset_version.",
  "type": "object",
  "required": ["wasm_sha256", "ruleset_version", "indicators", "not_checked", "claimed_meta"],
  "additionalProperties": false,
  "properties": {
    "wasm_sha256": { "$ref": "urn:sorosentinel:schema:v1:common#/$defs/sha256Hex" },
    "ruleset_version": { "$ref": "urn:sorosentinel:schema:v1:common#/$defs/rulesetVersion" },
    "indicators": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["code", "informational"],
        "additionalProperties": false,
        "properties": {
          "code": { "type": "string", "pattern": "^S-[A-Z0-9-]+$" },
          "informational": {
            "description": "Informational indicators never raise a level alone.",
            "type": "boolean"
          },
          "facts": { "$ref": "urn:sorosentinel:schema:v1:common#/$defs/facts" }
        }
      }
    },
    "not_checked": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "pattern": "^NC-[A-Z0-9-]+$" }
    },
    "claimed_meta": {
      "description": "Values read from the WASM's own spec/meta custom sections. Untrusted claims: may be absent or wrong.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "spec_present": { "type": "boolean" },
        "sdk_version": { "type": "string", "maxLength": 64 },
        "protocol_version": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
